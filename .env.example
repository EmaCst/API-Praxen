NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DB_POOL_MAX=5
DB_SSL=true
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=12h
CORS_ORIGINS=http://localhost:5173
GOOGLE_CLIENT_IDS=your-android-client-id.apps.googleusercontent.com,your-web-client-id.apps.googleusercontent.com
PASSWORD_RESET_URL=praxen://reset-password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Praxen <no-reply@example.com>
